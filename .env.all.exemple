# Backend configuration
BACKEND_PORT=5000
FRONTEND_PORT=5173
BACKEND_ADMIN_PORT=5001
FRONTEND_ADMIN_PORT=5174

# MariaDB configuration
MYSQL_ROOT_PASSWORD=example_password
MYSQL_DATABASE=name_db
MYSQL_USER=user
