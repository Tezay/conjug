# App configuration
APP_ENV=production

# Domain configuration
FRONTEND_DOMAIN=frontend.localhost
FRONTEND_ADMIN_DOMAIN=frontendAdmin.localhost
BACKEND_DOMAIN=backend.localhost
BACKEND_ADMIN_DOMAIN=backendAdmin.localhost

# Port configuration
FRONTEND_PORT=80
FRONTEND_ADMIN_PORT=80

# MariaDB configuration
MYSQL_ROOT_PASSWORD=example_password
MYSQL_DATABASE=name_db
MYSQL_USER=user
MYSQL_PASSWORD=user_password
DB_PORT=3006

# Secret key configuration
SECRET_KEY=dev_secret_key

# API configuration
VITE_BACKEND_URL=http://backend.localhost/api
VITE_BACKEND_ADMIN_URL=http://backendAdmin.localhost/api

# Build configuration
BACKEND_TARGET=dev
FRONTEND_TARGET=dev
BACKEND_ADMIN_TARGET=dev
FRONTEND_ADMIN_TARGET=dev

