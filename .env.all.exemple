VITE_ADMIN_API_URL=http://localhost:5001/api/

# Build configuration
BACKEND_TARGET=dev
FRONTEND_TARGET=dev
BACKEND_ADMIN_TARGET=dev
FRONTEND_ADMIN_TARGET=dev

